!sources/MANIFEST.md

# notebooks: percent-format .py is the source of truth
*.ipynb
.ipynb_checkpoints/

# os
.DS_Store
*:Zone.Identifier

# Editor lock files and Windows copies
~$*
* - Copy.*
*:Zone.Identifier
